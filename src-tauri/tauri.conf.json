{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UltiCP",
  "version": "0.1.0",
  "identifier": "com.ulticp.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "UltiCP — Portapapeles Avanzado & Snippets (Local-First)",
        "width": 1160,
        "height": 760,
        "minWidth": 820,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}

